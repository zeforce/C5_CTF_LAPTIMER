CONFIG_IDF_TARGET="esp32c3"
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Application maintains one phone client and one outstanding command.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC_ONLY=1

# Dual-C5 profile. Second C5 CS=0 READY=1, INT unused (polling).
CONFIG_C3_DUAL_C5=y
CONFIG_C3_FEEDBACK_WS2812_GPIO=20
CONFIG_C3_FEEDBACK_BUZZER_GPIO=21
